# Copy to .env and fill in. NEVER commit the real .env to source control.

# --- Bhashini / ULCA credentials (required for Bhashini + transliteration) ---
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_ULCA_KEY=your_udyat_key_here
# Optional: override the MeitY pipeline id if C-DAC uses a different one.
MEITY_PIPELINE_ID=64392f96daac500b55c543cd

# --- Upstream endpoints (defaults are usually fine) ---
# BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
# CDAC_PUNE_URL=https://nlpsangraha.ebhasha.in/getTranslation

# --- Server ---
PORT=8080

# Comma-separated list of allowed browser origins.
# Use "*" ONLY for local testing. In production set this to the published
# extension's origin, e.g. chrome-extension://<your-32-char-extension-id>
ALLOWED_ORIGINS=*

# --- Abuse protection (optional; sensible defaults shown) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
MAX_TEXT_LENGTH=5000
