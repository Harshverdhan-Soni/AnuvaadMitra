{
  "manifest_version": 3,
  "name": "CDAC AnuvaadMitra",
  "description": "CDAC AnuvaadMitra: select English text on any page and get a Hindi translation ready to copy. Choose Bhashini, C-DAC Pune, or Google Translate, with automatic fallback.",
  "version": "5.17.2",
  "minimum_chrome_version": "119",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://anuvaadmitra.cdac.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CDAC AnuvaadMitra"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
