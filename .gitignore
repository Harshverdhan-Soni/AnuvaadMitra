# server or build artifacts. Keep packaged bundles out of version control.
*.zip
*.crx
*.pem
web-ext-artifacts/
dist/
dist-internal/

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.docx
~$*
# scratch render previews (safe to delete)
.gp*.jpg
.gg*.jpg
.preview*.jpg