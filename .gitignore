# ---- Secrets: never commit credentials ----
.env
*.env
!.env.example
proxy-server/.env

# ---- Node / proxy-server ----
node_modules/
proxy-server/node_modules/
npm-debug.log*
*.log

# ---- Chrome Web Store packaging artifacts ----
